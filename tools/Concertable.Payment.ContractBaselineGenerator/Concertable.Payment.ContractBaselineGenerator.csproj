<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaselineVersion>0.1.0-alpha.0.1009</BaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concertable.Payment.Client" VersionOverride="$(BaselineVersion)" />
    <PackageReference Include="Concertable.Payment.Contracts" VersionOverride="$(BaselineVersion)" />
