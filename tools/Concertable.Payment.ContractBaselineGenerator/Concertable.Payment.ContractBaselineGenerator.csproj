<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompositionValidationExclusion>No dependency-injection container or host builder.</CompositionValidationExclusion>
  </PropertyGroup>

  <Import Project="..\..\PublishedBaseline.props" />

  <ItemGroup>
    <PackageReference Include="Concertable.Payment.Client" VersionOverride="$(PaymentBaselineVersion)" />
    <PackageReference Include="Concertable.Payment.Contracts" VersionOverride="$(PaymentBaselineVersion)" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\Concertable.Payment.UnitTests\Compatibility\PublicApiSnapshot.cs" Link="PublicApiSnapshot.cs" />
  </ItemGroup>

</Project>
