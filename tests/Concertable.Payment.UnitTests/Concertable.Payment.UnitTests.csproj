<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Reunion" />
    <PackageReference Include="Reunion.Errors" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Concertable.Payment.Application\Concertable.Payment.Application.csproj" />
    <ProjectReference Include="..\..\src\Concertable.Payment.Client\Concertable.Payment.Client.csproj" Aliases="PaymentClient" />
    <ProjectReference Include="..\..\src\Concertable.Payment.Domain\Concertable.Payment.Domain.csproj" />
    <ProjectReference Include="..\..\src\Concertable.Payment.Infrastructure\Concertable.Payment.Infrastructure.csproj" Aliases="global,PaymentInfrastructure" />
    <ProjectReference Include="..\Compatibility\Concertable.Payment.PublishedContractFixture\Concertable.Payment.PublishedContractFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\E2ETests\Concertable.Payment.E2ETests.Stripe\Concertable.Payment.E2ETests.Stripe.csproj" />
    <PackageReference Include="Concertable.Testing" />
  </ItemGroup>

  <Import Project="..\..\PublishedBaseline.props" />

  <ItemGroup>
    <None Update="Compatibility\Baselines\**\*" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PaymentBaselineVersion</_Parameter1>
      <_Parameter2>$(PaymentBaselineName)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Concertable.Payment.Domain.Entities" />
    <Using Include="Concertable.Payment.Domain.Enums" />
    <Using Include="Concertable.Payment.Contracts" />
    <Using Include="Concertable.Payment.Contracts.Enums" />
    <Using Include="Concertable.Payment.Application.DTOs" />
    <Using Include="Concertable.Payment.Application.Mappers" />
  </ItemGroup>

</Project>
