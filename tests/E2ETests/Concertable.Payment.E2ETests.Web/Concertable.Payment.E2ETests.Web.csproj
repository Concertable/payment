<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <BaseOutputPath>$(ConcertableServiceRoot)artifacts\e2e\payment-web\</BaseOutputPath>
    <ContainerRepository>concertable/payment-web</ContainerRepository>
    <CompositionValidationExclusion>E2E adapter executable covered by the production Payment Web composition root.</CompositionValidationExclusion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\api\src\Concertable.Payment.Web\Concertable.Payment.Web.csproj" />
    <ProjectReference Include="..\Concertable.Payment.E2ETests.Server\Concertable.Payment.E2ETests.Server.csproj" />
    <ProjectReference Include="..\Concertable.Payment.E2ETests.Stripe\Concertable.Payment.E2ETests.Stripe.csproj" />
  </ItemGroup>

  <!-- Reuse the production host's E2E configuration; this host adds only the Stripe adapter swap. -->
  <ItemGroup>
    <Content Include="..\..\..\api\src\Concertable.Payment.Web\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\api\src\Concertable.Payment.Web\appsettings.E2E.json" Link="appsettings.E2E.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerPort Include="8081" Type="tcp" />
    <ContainerEnvironmentVariable Include="ASPNETCORE_HTTP_PORTS" Value="8080;8081" />
    <ContainerEnvironmentVariable Include="PaymentTransport__GrpcPort" Value="8081" />
  </ItemGroup>

</Project>
